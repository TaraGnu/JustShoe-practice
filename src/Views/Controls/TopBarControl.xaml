<UserControl x:Class="JustShop.Views.Controls.TopBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Times New Roman">

    <Border Background="{StaticResource SecondaryBackgroundBrush}" Padding="12,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип + заголовок -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Images/Shoes.png"
                       Height="42"
                       Margin="0,0,16,0"
                       Stretch="Uniform"/>
                <TextBlock x:Name="TitleText"
                           FontSize="24"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Кнопки навигации и пользователь -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CatalogButton"
                        Content="Каталог"
                        Click="CatalogButton_Click"
                        Margin="0,0,10,0"/>

                <Button x:Name="OrdersButton"
                        Content="Заказы"
                        Click="OrdersButton_Click"
                        Visibility="Collapsed"
                        Margin="0,0,16,0"/>

                <TextBlock x:Name="UserNameText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Button x:Name="ActionButton"
                        Click="ActionButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>