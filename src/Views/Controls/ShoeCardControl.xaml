<UserControl x:Class="JustShop.Views.Controls.ShoeCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:JustShop.Views.Controls"
             FontFamily="Times New Roman">

    <Border x:Name="RootBorder"
            BorderBrush="{StaticResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            Margin="0,0,0,10">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PrimaryBackgroundBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHighDiscount}" Value="True">
                        <Setter Property="Background" Value="{StaticResource HighDiscountBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="White"/>
                    </DataTrigger>

                    <!-- Нет в наличии: голубой фон. Идёт ПОСЛЕ скидки,
                         поэтому при равенстве условий выигрывает -->
                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                        <Setter Property="Background" Value="{StaticResource OutOfStockBrush}"/>
                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Фото -->
            <Border Grid.Column="0" Width="160" Height="120"
                    BorderBrush="{StaticResource BorderBrushLight}"
                    BorderThickness="1"
                    Margin="0,0,15,0">
                <Image Source="{Binding ImagePath}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Данные -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,4">
                    <Run Text="{Binding CategoryName, Mode=OneWay}"/>
                    <Run Text=" | "/>
                    <Run Text="{Binding Name, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,0,0,2">
                    <Run Text="Описание товара: " FontWeight="SemiBold"/>
                    <Run Text="{Binding Description, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,0,0,2">
                    <Run Text="Производитель: " FontWeight="SemiBold"/>
                    <Run Text="{Binding FabricatorName, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,0,0,2">
                    <Run Text="Поставщик: " FontWeight="SemiBold"/>
                    <Run Text="{Binding SupplierName, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,0,0,2">
                    <Run Text="Цена: " FontWeight="SemiBold"/>
                    <Run Text="{Binding PriceWithDiscount, StringFormat='{}{0:N2} ₽', Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12" Margin="0,0,0,2">
                    <Run Text="Единица измерения: " FontWeight="SemiBold"/>
                    <Run Text="{Binding Units, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock FontSize="12">
                    <Run Text="Количество на складе: " FontWeight="SemiBold"/>
                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- Скидка -->
            <Border Grid.Column="2" Width="120"
                    Background="{StaticResource AccentBrush}"
                    CornerRadius="6" Padding="8"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Discount, StringFormat='Скидка {0:N0}%'}"
                           FontSize="14" FontWeight="Bold"
                           TextAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>
        </Grid>
    </Border>
</UserControl>