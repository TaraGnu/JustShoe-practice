<Page x:Class="JustShop.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:JustShop.Views.Controls"
      Title="Вход в систему"
      FontFamily="Times New Roman"
      Background="{StaticResource PrimaryBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <controls:TopBarControl Grid.Row="0"
                                x:Name="TopBar"
                                Title="Вход в систему"
                                ShowAuthButton="False"
                                CatalogRequested="TopBar_CatalogRequested"/>

        <Border Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                Padding="30"
                Background="{StaticResource PrimaryBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Вход в систему"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Логин" FontSize="14" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginTextBox"
                         Text="{Binding LoginInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="LoginTextBox_KeyDown"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Пароль" FontSize="14" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox"
                             KeyDown="PasswordBox_KeyDown"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Button Content="Войти"
                        Click="LoginButton_Click"
                        IsDefault="True"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource AccentBrush}"
                        FontSize="15"
                        Margin="0,0,0,10"/>

                <Button Content="Войти как гость"
                        Click="GuestButton_Click"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource SecondaryBackgroundBrush}"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>